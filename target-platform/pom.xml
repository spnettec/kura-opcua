<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Aggregator for kura-opcua's local target-platform deps. p2-repo-opcua-deps converts
        non-OSGi maven jars (milo, netty, guava, bouncycastle, jakarta) to P2 bundles via
        the reficio plugin, then install-to-m2.sh copies them into ~/.m2 under the
        p2.osgi.bundle groupId so the target-definition Maven location can pull them.
    -->
    <groupId>org.eclipse.kura</groupId>
    <artifactId>kura-opcua-target-platform</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>kura-opcua target platform</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <p2-maven-plugin.version>2.1.0</p2-maven-plugin.version>

        <org.eclipse.milo.version>1.1.2</org.eclipse.milo.version>
        <io.netty.version>4.2.12.Final</io.netty.version>
        <guava.version>33.4.0-jre</guava.version>
        <failureaccess.version>1.0.2</failureaccess.version>
        <org.bouncycastle.version>1.84</org.bouncycastle.version>
        <jakarta.activation-api.version>2.1.2</jakarta.activation-api.version>
        <jakarta.xml.bind-api.version>4.0.2</jakarta.xml.bind-api.version>
        <jaxb-osgi.version>4.0.2</jaxb-osgi.version>
    </properties>

    <modules>
        <module>p2-repo-opcua-deps</module>
    </modules>
</project>
