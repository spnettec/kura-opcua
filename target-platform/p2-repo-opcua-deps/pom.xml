<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.kura</groupId>
        <artifactId>kura-opcua-target-platform</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>p2-repo-opcua-deps</artifactId>
    <packaging>pom</packaging>
    <name>P2 site for kura-opcua-specific deps</name>

    <build>
        <plugins>
            <plugin>
                <groupId>org.reficio</groupId>
                <artifactId>p2-maven-plugin</artifactId>
                <version>${p2-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>generate-p2-site</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>site</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <!--
                                    kura-opcua-exclusive deps. Everything else
                                    (netty, guava, bouncycastle, jakarta XML, jaxb-osgi)
                                    is in monorepo's target-platform-pde-deps and
                                    consumed via Maven location in kura-opcua.target.

                                    Future addons or version bumps that monorepo doesn't
                                    ship — slot them in here.
                                -->

                                <!-- Eclipse Milo 1.1.2 — only opcua bundle uses it. -->
                                <artifact>
                                    <id>org.eclipse.milo:milo-sdk-client:jar:${org.eclipse.milo.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>org.eclipse.milo:milo-sdk-core:jar:${org.eclipse.milo.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>org.eclipse.milo:milo-stack-core:jar:${org.eclipse.milo.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>org.eclipse.milo:milo-transport:jar:${org.eclipse.milo.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>

                                <!-- Digital Petri FSM — milo client transitive. -->
                                <artifact>
                                    <id>com.digitalpetri.fsm:strict-machine:${com.digitalpetri.strict-machine.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>com.digitalpetri.netty:netty-channel-fsm:${com.digitalpetri.channel-fsm.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>install-p2-bundles-to-local-m2</id>
                        <phase>install</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="${project.basedir}/../install-to-m2.sh"
                                      dir="${project.basedir}"
                                      failonerror="true">
                                    <arg value="${project.build.directory}/repository/plugins" />
                                    <arg value="p2.osgi.bundle" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>
</project>
